# Copy outside the repository, fill real values, and pass it with --env-file.
VEXPLORER_HOSTNAME=vexplorer.example.com
VEXPLORER_TLS_EMAIL=operations@example.com
VEXPLORER_ALLOWED_ORIGINS=https://vexplorer.example.com
VEXPLORER_USERS_FILE_HOST=/srv/vexplorer/secrets/users.json
VEXPLORER_COST_CATALOG_HOST=/srv/vexplorer/config/cost-catalog.json
VEXPLORER_JOB_MAX_PENDING=8
VEXPLORER_DATA_VOLUME=vexplorer_data
# Optional only when the historical SQLite store must live outside VEXPLORER_DATA_DIR.
# Keep it inside the data volume by default so backup auto-discovers history.sqlite3.
# VEXPLORER_HISTORY_DB=/var/lib/vexplorer/data/history.sqlite3
# Empty for a dedicated hostname; `/vexplorer` behind the shared VPS Caddy.
VEXPLORER_ROOT_PATH=
VEXPLORER_MAX_STORAGE_BYTES=1073741824
# Historical recording budget, separate from the 15 model calls allowed per run.
VEXPLORER_RECORDING_MAX_COUNT=1000
VEXPLORER_RECORDING_MAX_BYTES=268435456
# Optional; omit for geometry_only operation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MAX_OUTPUT_TOKENS=16384
OPENAI_VISION_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=256
# OPENAI_BASE_URL=https://api.openai.com/v1
# Autonomous multimodal critic; separate from the proposing model above.
VEXPLORER_GENERAL_REVIEW_MODEL=gpt-6-astra
VEXPLORER_GENERAL_REVIEW_MAX_OUTPUT_TOKENS=16384
VEXPLORER_GENERAL_REVIEW_MAX_CALLS=5
VEXPLORER_GENERAL_REVIEW_MAX_REPAIRS=2
VEXPLORER_GENERAL_REVIEW_MAX_SEMANTIC_REPAIRS=2
VEXPLORER_GENERAL_JOB_TIMEOUT_SECONDS=600
# Optional DWG support. LibreDWG is the deployable open-source fallback; use an absolute path.
# VEXPLORER_DWG_CONVERTER=libredwg
# VEXPLORER_DWG2DXF_EXECUTABLE=/opt/vexplorer/bin/dwg2dxf
# ODA remains optional; do not set until commercial-use rights and a genuine-file smoke are approved.
# VEXPLORER_ODA_EXECUTABLE=/opt/vexplorer/bin/ODAFileConverter
# Enable only after publishing an authorized corpus and checking the private pilot.
VEXPLORER_EXPLORER_ENABLED=0
VEXPLORER_JEV_DAILY_ATTEMPTS=0
# Optional VEXPLORER_JEV_API_KEY: supply through the server secret manager.

# Public CAD mode: set false deliberately; shared history/catalog writes remain private.
VEXPLORER_AUTH_ENABLED=true
VEXPLORER_PUBLIC_LIVE_DAILY_LIMIT=10
VEXPLORER_PUBLIC_LIVE_CLIENT_DAILY_LIMIT=3
