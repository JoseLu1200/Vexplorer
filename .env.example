# Live mode is unavailable unless both values are configured on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MAX_OUTPUT_TOKENS=16384
# Controls only the legacy table-analysis vision path. General-furniture
# autonomous analysis always sends its bounded source-image evidence.
OPENAI_VISION_ENABLED=false
# Independent multimodal critic for general furniture.
VEXPLORER_GENERAL_REVIEW_MODEL=gpt-6-astra
VEXPLORER_GENERAL_REVIEW_MAX_OUTPUT_TOKENS=16384
VEXPLORER_GENERAL_REVIEW_MAX_CALLS=5
VEXPLORER_GENERAL_REVIEW_MAX_REPAIRS=2
VEXPLORER_GENERAL_JOB_TIMEOUT_SECONDS=300
# EmbeddingGemma 2 runtime: pinned local text space (768d, L2). No network fallback.
VEXPLORER_EMBEDDING_MODEL=embeddinggemma2
VEXPLORER_EMBEDDING_REVISION=f9972ac22e696a105c482202646979e33e4b5a1e
# Point to the exact Hugging Face snapshot directory named by the revision above.
VEXPLORER_EMBEDDING_SNAPSHOT=
VEXPLORER_EMBEDDING_DEVICE=cpu
# OPENAI_BASE_URL=https://api.openai.com/v1

# Private-team deployment: use deploy/production.env.example and docs/PRODUCCION.md.
# Local development stays unauthenticated and must bind to 127.0.0.1.
# VEXPLORER_ENV=production
# VEXPLORER_DATA_DIR=/var/lib/vexplorer/data
# VEXPLORER_USERS_FILE=/run/secrets/vexplorer_users
# VEXPLORER_ALLOWED_ORIGINS=https://your-private-host.example
# VEXPLORER_COST_CATALOG=/run/config/vexplorer-cost-catalog.json
# VEXPLORER_JOB_MAX_PENDING=8
# VEXPLORER_JOB_MAX_WORKERS=2
# Recording capacity is reserved before paid inference; existing recordings are retained.
# VEXPLORER_RECORDING_MAX_COUNT=1000
# VEXPLORER_RECORDING_MAX_BYTES=268435456

# Optional semantic explorer; local vectors do not incur inference per query.
VEXPLORER_EXPLORER_ENABLED=0
VEXPLORER_JEV_DAILY_ATTEMPTS=0
# VEXPLORER_JEV_API_KEY is supplied by the server secret manager when enabled.
# Explicit opt-out for public deployments; production defaults to authentication.
# VEXPLORER_AUTH_ENABLED=false
