    "document_upload": {
      "evidence": "valid DXF stored with matching SHA-256 and size",
      "state": "works"
    },
    "drawing_and_svg_preview": {
      "evidence": "metric, unknown-unit and trapezoid previews observed",
      "state": "works"
    },
    "dwg_pdf_and_non_rectangular_decomposition": {
      "evidence": "upload accepts DXF only; trapezoid run rejected",
      "state": "not_implemented_for_demo"
    },
    "economy": {
      "evidence": "three synthetic comparables; repeat estimate 127.84 EUR without duplicated concepts",
      "state": "synthetic_demo_only"
    },
    "live_agent": {
      "evidence": "provider configuration was read but live mode was intentionally not called",
      "state": "not_exercised"
    },
    "offline_library_and_geometric_similarity": {
      "evidence": "own translated/dimensional/structural controls located among shared library state",
      "state": "works"
    },
    "reconstruction": {
      "evidence": "six physical occurrences and independent volume matched",
      "state": "works_after_review"
    },
    "recorded_replay": {
      "evidence": "explicit recorded_replay_unavailable response",
      "state": "not_implemented"
    },
    "rectangular_decomposition": {
      "evidence": "geometry_only created two-scenario runs; trapezoid abstained",
      "state": "works_for_declared_demo_subset"
    },
    "revision_history_and_stale_guard": {
      "evidence": "revisions 1/2 preserved; stale write returned 409",
      "state": "works"
    },
    "semantic_similarity": {
      "evidence": "offline item returned semantic_embedding_missing; no provider call made",
      "state": "not_exercised"
    },
    "separate_piece_views_without_mounted_model": {
      "evidence": "audited workflow derives assembly scenarios from a mounted furniture drawing; it does not accept the newly requested piece-only multi-view quantity contract",
      "state": "not_implemented"
    }
